[Unit]
Description=MeshDrive Filebrowser (LAN + loopback)
After=network-online.target meshdrive-agent.service
Wants=meshdrive-agent.service

[Service]
Type=simple
User=meshdrive
Group=meshdrive
Environment=MESHDRIVE_ROOT=/opt/meshdrive
WorkingDirectory=/opt/meshdrive
ExecStartPre=/bin/mkdir -p /opt/meshdrive/mnt /opt/meshdrive/var
ExecStart=/opt/meshdrive/bin/filebrowser -c /opt/meshdrive/etc/filebrowser.json
Restart=always
RestartSec=3
TimeoutStartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/meshdrive/var /opt/meshdrive/mnt
ReadOnlyPaths=/opt/meshdrive/etc /opt/meshdrive/bin
# LAN access: no IPAddressDeny. Restrict with host firewall if needed
# (ufw allow from 192.168.0.0/16 to any port 8080).

[Install]
WantedBy=multi-user.target
