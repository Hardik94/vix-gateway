# Optional overrides for docker compose (copy to .env next to compose file).
MESHDRIVE_VERSION=v2.3.1
MESHDRIVE_DEB_VERSION=2.3.1
MESHDRIVE_AGENT_PORT=12700
MESHDRIVE_FB_PORT=8080
MESHDRIVE_MCP_PORT=9000
# Set to 1 to run `meshdrive addons install mcp` on container start
MESHDRIVE_INSTALL_MCP=0
MESHDRIVE_INSTALL_OPENFGA=0
